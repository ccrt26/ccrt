      "white_paper_ref": "CLAUDE.md §五工程规范",
      "expected_output": "release_gate.py串联6闸门，任一FAIL→BLOCK exit≠0，全部PASS→RELEASE_READY exit=0"
    },
    {
      "id": "A4",
      "file": "代码文件/tools/git_autocommit.py",
      "description": "将正式报告目录(重点股票/深度分析/深度分析报告/)从AUTOCOMMIT_PATHS移除，加入发布受控目录",
      "code_level": "L1",
      "change": "AUTOCOMMIT_PATHS中移除重点股票/深度分析/；pipeline_auth.py PROTECTED_PATHS中新增重点股票/深度分析/深度分析报告/",
      "validation": "正式报告目录文件不再被auto-commit豁免，需pipeline token+release_gate",
      "white_paper_ref": "CLAUDE.md §七关键工具",
      "expected_output": "正式报告目录从AUTOCOMMIT_PATHS移除，新增到PROTECTED_PATHS，auto-commit不再豁免"
