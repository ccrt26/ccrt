{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CCRT Stage Gate Auto Advance Registry",
  "type": "object",
  "required": [
    "version",
    "description",
    "artifact_types",
    "advance_rules",
    "repair_rules",
    "user_escalation_rules",
    "safety_limits"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "artifact_types": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["type", "meaning", "formal"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": ["candidate", "formal_signoff", "archive_record"]
          },
          "meaning": {
            "type": "string"
          },
          "formal": {
            "type": "boolean"
          }
        }
      }
    },
    "advance_rules": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "from_gate",
          "to_gate",
          "required_artifact_type",
          "required_result",
          "formal_signoff_required",
          "action",
          "stop_if"
        ],
        "additionalProperties": false,
        "properties": {
          "rule_id": { "type": "string" },
          "from_gate": { "type": "string" },
          "to_gate": { "type": "string" },
          "required_artifact_type": {
            "type": "string",
            "enum": ["candidate", "formal_signoff", "archive_record"]
          },
          "required_role": { "type": ["string", "null"] },
          "required_result": {
            "type": "string",
            "enum": ["PASS"]
          },
          "formal_signoff_required": { "type": "boolean" },
          "action": {
            "type": "string",
            "enum": ["create_dispatch", "archive_after_g6"]
          },
          "stop_if": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "repair_rules": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "issue",
          "classification",
          "return_to_gate",
          "dispatch_action",
          "user_escalation"
        ],
        "additionalProperties": false,
        "properties": {
          "issue": { "type": "string" },
          "classification": {
            "type": "string",
            "enum": [
              "recoverable_block",
              "missing_signoff",
              "permission_block",
              "security_repair",
              "user_decision_block"
            ]
          },
          "return_to_gate": { "type": "string" },
          "dispatch_action": { "type": "string" },
          "user_escalation": { "type": "boolean" }
        }
      }
    },
    "user_escalation_rules": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "safety_limits": {
      "type": "object",
      "required": ["max_auto_repair_attempts", "default_archive_mode"],
      "additionalProperties": false,
      "properties": {
        "max_auto_repair_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "default_archive_mode": {
          "type": "string",
          "enum": ["dry_run"]
        }
      }
    }
  }
}
