{
  "version": "1.0",
  "description": "角色唤醒与输出规范矩阵 — 承接 ROLE_角色唤醒与输出规范_v1.0.md",
  "source_md": "00_项目地基/05_流程与角色/ROLE_角色唤醒与输出规范_v1.0.md",
  "roles": [
    {
      "role": "阿黑",
      "line": "调度",
      "responsibilities": "流程路由、阶段调度、争议协调",
      "is_primary": true
    },
    {
      "role": "腰子",
      "line": "金融线",
      "responsibilities": "金融口径、最终签字（金融线负责人）",
      "is_primary": true
    },
    {
      "role": "山猫",
      "line": "金融线",
      "responsibilities": "宏观信息支撑",
      "is_primary": false
    },
    {
      "role": "信鸽",
      "line": "金融线",
      "responsibilities": "事件信息支撑",
      "is_primary": false
    },
    {
      "role": "玉夜",
      "line": "金融线",
      "responsibilities": "数据事实审查、数据方案",
      "is_primary": false
    },
    {
      "role": "流金",
      "line": "金融线",
      "responsibilities": "风控边界审计",
      "is_primary": false
    },
    {
      "role": "青山",
      "line": "金融线",
      "responsibilities": "策略方案、后评估",
      "is_primary": false
    },
    {
      "role": "砺石",
      "line": "金融线",
      "responsibilities": "方法校准、反证审查",
      "is_primary": false
    },
    {
      "role": "情墨",
      "line": "工程线",
      "responsibilities": "架构设计、制度维护",
      "is_primary": true
    },
    {
      "role": "千光",
      "line": "工程线",
      "responsibilities": "CI/CD、自动化编排",
      "is_primary": false
    },
    {
      "role": "红枫",
      "line": "工程线",
      "responsibilities": "部署、环境管理",
      "is_primary": false
    },
    {
      "role": "新安",
      "line": "工程线",
      "responsibilities": "测试策略、回归验收",
      "is_primary": false
    },
    {
      "role": "红结",
      "line": "工程线",
      "responsibilities": "编码实现",
      "is_primary": true
    },
    {
      "role": "旧影",
      "line": "审计线",
      "responsibilities": "独立审计、阶段复查",
      "is_primary": true
    }
  ],
  "flow_role_mapping": {
    "F-ARCH": [
      "阿黑",
      "情墨",
      "旧影",
      "腰子"
    ],
    "F-DATA": [
      "阿黑",
      "玉夜",
      "旧影",
      "腰子"
    ],
    "F-REPORT": [
      "阿黑",
      "情墨",
      "玉夜",
      "旧影",
      "腰子"
    ],
    "F-ANALYSIS": [
      "阿黑",
      "腰子",
      "青山",
      "流金",
      "山猫",
      "信鸽",
      "玉夜",
      "砺石",
      "旧影"
    ],
    "F-ROLE": [
      "阿黑",
      "腰子",
      "情墨",
      "全部解释角色",
      "旧影"
    ],
    "F-EVAL": [
      "阿黑",
      "青山",
      "玉夜",
      "旧影"
    ],
    "F-KNOW": [
      "阿黑",
      "青山",
      "腰子",
      "旧影"
    ],
    "F-GATE": [
      "阿黑",
      "玉夜",
      "旧影",
      "情墨"
    ],
    "F-FIX": [
      "阿黑",
      "问题所属角色",
      "玉夜/旧影",
      "腰子"
    ],
    "F-MIGRATE": [
      "阿黑",
      "情墨",
      "旧影"
    ],
    "F-FEATURE": [
      "阿黑",
      "情墨",
      "腰子",
      "旧影"
    ],
    "F-SCHEDULE": [
      "阿黑",
      "情墨",
      "千光",
      "旧影"
    ]
  },
  "timing": {
    "G0": "阿黑（路由）",
    "G1": "金融团队（腰子+山猫+信鸽+玉夜+流金+青山；砺石按需）；若涉及报告也引入情墨",
    "G2": "情墨（架构设计）+ 玉夜（数据方案）",
    "G3": "红结（编码/改文档）",
    "G4": "红结（自检候选）+ 新安（测试验收）",
    "G5": "旧影（独立复查）",
    "G6": "阿黑（放行）+ 腰子（签字）"
  },
  "output_format": {
    "description": "每个被唤醒角色输出必须包含以下7个字段",
    "fields": [
      {
        "name": "角色名",
        "label": "角色名：【】",
        "required": true
      },
      {
        "name": "参与阶段门",
        "label": "参与阶段门：【G0/G1/G2/G3/G4/G5/G6】",
        "required": true
      },
      {
        "name": "本阶段职责",
        "label": "本阶段职责：【一句话说明】",
        "required": true
      },
      {
        "name": "检查对象",
        "label": "检查对象：【路径/文件/范围】",
        "required": true
      },
      {
        "name": "结论",
        "label": "结论：【PASS / BLOCK / WARN】",
        "required": true
      },
      {
        "name": "依据",
        "label": "依据：【文件/命令/规则编号】",
        "required": true
      },
      {
        "name": "遗留问题",
        "label": "遗留问题：【如有】",
        "required": false
      }
    ]
  },
  "g5_review_format": {
    "description": "G5独立复查格式",
    "fields": [
      {
        "name": "复查角色",
        "label": "复查角色：旧影"
      },
      {
        "name": "复查范围",
        "label": "复查范围：【验收报告+命令+文件】"
      },
      {
        "name": "复查结果",
        "label": "复查结果：【命令通过率 / 文件范围合规 / 角色输出完备性】"
      },
      {
        "name": "总体结论",
        "label": "总体结论：【建议通过 / 需补修 / 不通过】"
      },
      {
        "name": "遗留问题",
        "label": "遗留问题：【如有】"
      }
    ]
  },
  "block_rules": [
    {
      "condition": "必唤醒角色未输出结论",
      "action": "BLOCK",
      "description": "任何必唤醒角色缺少输出即阻塞"
    },
    {
      "condition": "阿黑代签角色结论",
      "action": "BLOCK",
      "description": "阿黑是调度者，不得代签"
    },
    {
      "condition": "AI 工具以角色身份签结论",
      "action": "BLOCK",
      "description": "DeepSeek/Claude/Codex 不是项目角色，不得以角色身份签结论"
    },
    {
      "condition": "G5复查缺失",
      "action": "BLOCK",
      "description": "G5独立复查不可跳过"
    },
    {
      "condition": "角色输出BLOCK",
      "action": "BLOCK",
      "description": "转化为阶段BLOCK"
    },
    {
      "condition": "角色输出PASS/WARN",
      "action": "PASS",
      "description": "汇总到验收报告"
    },
    {
      "condition": "跳过角色未说明",
      "action": "BLOCK",
      "description": "跳过必唤醒角色必须在验收报告中逐条说明"
    },
    {
      "condition": "阿黑执行 G3/G4/G5",
      "action": "BLOCK",
      "description": "阿黑是调度者，不得实施或审计"
    },
    {
      "condition": "G3 实施者执行 G5 独立审计",
      "action": "BLOCK",
      "description": "实施与审计分离"
    },
    {
      "condition": "Codex/DeepSeek/Claude/LangGraph 被写成项目角色",
      "action": "BLOCK",
      "description": "工具不是项目角色"
    },
    {
      "condition": "G4 缺少测试或验证命令",
      "action": "BLOCK",
      "description": "G4 必须有可执行验证"
    },
    {
      "condition": "G5 缺少旧影独立审计",
      "action": "BLOCK",
      "description": "旧影 G5 不可跳过"
    }
  ],
  "role_boundary_contract": {
    "version": "1.0",
    "purpose": "固化 CCRT 项目角色边界。G0-G6 是项目团队标准流程；Codex/DeepSeek/Claude/LangGraph 只能是工具或执行承载，不得写成项目角色。",
    "stage_owners": {
      "G0": [
        "阿黑"
      ],
      "G1": [
        "腰子"
      ],
      "G2": [
        "情墨"
      ],
      "G3": [
        "红结"
      ],
      "G4": [
        "新安"
      ],
      "G5": [
        "旧影"
      ],
      "G6": [
        "腰子",
        "阿黑"
      ]
    },
    "role_rules": {
      "阿黑": {
        "title": "项目总监",
        "primary_gate": "G0",
        "allowed_gates": [
          "G0",
          "G6"
        ],
        "responsibility": "需求识别、流程路由、阶段调度、争议协调、闭环汇总",
        "can_sign_for_others": false,
        "forbidden": [
          "implementation",
          "test_acceptance",
          "independent_audit",
          "role_substitution",
          "final_business_signoff"
        ]
      },
      "腰子": {
        "title": "金融业务负责人",
        "primary_gate": "G6",
        "allowed_gates": [
          "G1",
          "G6"
        ],
        "responsibility": "业务/金融口径确认、最终业务放行",
        "can_sign_for_others": false
      },
      "山猫": {
        "title": "宏观巡检官",
        "primary_gate": "G1",
        "allowed_gates": [
          "G1"
        ],
        "responsibility": "宏观信息支撑与宏观口径核查",
        "can_sign_for_others": false
      },
      "信鸽": {
        "title": "信息采集员",
        "primary_gate": "G1",
        "allowed_gates": [
          "G1"
        ],
        "responsibility": "事件信息采集与消息面核查",
        "can_sign_for_others": false
      },
      "玉夜": {
        "title": "数据监理",
        "primary_gate": "G1",
        "allowed_gates": [
          "G1",
          "G2",
          "G4",
          "G5"
        ],
        "responsibility": "数据事实审查、数据口径、数据完整性验收支持",
        "can_sign_for_others": false
      },
      "流金": {
        "title": "风控官",
        "primary_gate": "G1",
        "allowed_gates": [
          "G1",
          "G5"
        ],
        "responsibility": "风控边界、风险暴露、禁止条件审查",
        "can_sign_for_others": false
      },
      "青山": {
        "title": "策略研究员",
        "primary_gate": "G1",
        "allowed_gates": [
          "G1",
          "G5"
        ],
        "responsibility": "策略方案、后评估、策略影响判断",
        "can_sign_for_others": false
      },
      "砺石": {
        "title": "方法校准官",
        "primary_gate": "G1",
        "allowed_gates": [
          "G1",
          "G5"
        ],
        "responsibility": "方法校准、反证审查、口径偏差检查",
        "can_sign_for_others": false
      },
      "情墨": {
        "title": "系统架构师",
        "primary_gate": "G2",
        "allowed_gates": [
          "G2",
          "G5"
        ],
        "responsibility": "系统架构、制度设计、技术方案边界",
        "can_sign_for_others": false
      },
      "千光": {
        "title": "构建工程师(CI)",
        "primary_gate": "G2",
        "allowed_gates": [
          "G2",
          "G4"
        ],
        "responsibility": "CI/CD、自动化编排、构建链路验证",
        "can_sign_for_others": false
      },
      "红枫": {
        "title": "部署工程师(环境)",
        "primary_gate": "G2",
        "allowed_gates": [
          "G2",
          "G4"
        ],
        "responsibility": "运行环境、部署入口、环境依赖验证",
        "can_sign_for_others": false
      },
      "新安": {
        "title": "质量工程师(测试)",
        "primary_gate": "G4",
        "allowed_gates": [
          "G2",
          "G4"
        ],
        "responsibility": "测试策略、回归验收、验证命令结论",
        "can_sign_for_others": false
      },
      "红结": {
        "title": "代码工匠",
        "primary_gate": "G3",
        "allowed_gates": [
          "G2",
          "G3",
          "G4"
        ],
        "responsibility": "代码、脚本、配置实施；G4 只能提交自检候选",
        "can_sign_for_others": false
      },
      "旧影": {
        "title": "审计官",
        "primary_gate": "G5",
        "allowed_gates": [
          "G5"
        ],
        "responsibility": "独立审计、阶段复查、证据真实性检查",
        "can_sign_for_others": false
      }
    },
    "hard_block_rules": [
      {
        "condition": "阿黑执行 G3/G4/G5",
        "action": "BLOCK"
      },
      {
        "condition": "阿黑代签任何角色",
        "action": "BLOCK"
      },
      {
        "condition": "G3 实施者执行 G5 独立审计",
        "action": "BLOCK"
      },
      {
        "condition": "缺少阶段主责角色输出",
        "action": "BLOCK"
      },
      {
        "condition": "Codex/DeepSeek/Claude/LangGraph 被写成项目角色",
        "action": "BLOCK"
      },
      {
        "condition": "G4 缺少测试或验证命令",
        "action": "BLOCK"
      },
      {
        "condition": "G5 缺少旧影独立审计",
        "action": "BLOCK"
      },
      {
        "condition": "临时分析请求未执行 check_temp_analysis_force_route.py 前置门禁",
        "action": "BLOCK"
      },
      {
        "condition": "TEMP_ANALYSIS_REQUIRED 时角色绕过 TemporaryAnalysisBrief/gate/renderer 直接回答",
        "action": "BLOCK"
      },
      {
        "condition": "D07_v1.2 临时分析未内置砺石校准",
        "action": "BLOCK"
      }
    ],
    "temporary_analysis_force_route": {
      "route_policy": "00_项目地基/05_流程与角色/temp_analysis_force_route_policy_v0.1.json",
      "precheck_script": "scripts/check_temp_analysis_force_route.py",
      "must_use_when_decision": "TEMP_ANALYSIS_REQUIRED",
      "forbid_direct_role_answer": true,
      "d07_v1_2_lishi_integrated_by_default": true,
      "required_backend_chain": [
        "TemporaryAnalysisBrief",
        "check_temp_analysis_brief_gate.py",
        "render_temp_analysis_response.py"
      ]
    }
  }
}
