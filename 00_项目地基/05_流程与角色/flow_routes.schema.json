{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flow Routes Schema",
  "description": "流程路由表的 schema 定义 — 承接 FLOW_流程路由与阶段门_v1.0.md",
  "type": "object",
  "required": ["version", "description", "flows", "routing_rules", "directory_permissions", "non_bypass_rules"],
  "properties": {
    "version": { "type": "string" },
    "description": { "type": "string" },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["flow_code", "name", "applicable_scenes", "priority", "stages"],
        "properties": {
          "flow_code": { "type": "string", "pattern": "^F-[A-Z]+$" },
          "name": { "type": "string" },
          "applicable_scenes": { "type": "array", "items": { "type": "string" } },
          "priority": { "type": "integer" },
          "stages": {
            "type": "object",
            "properties": {
              "required_gates": { "type": "array", "items": { "type": "string" } },
              "default_path": { "type": "string" }
            }
          }
        }
      }
    },
    "routing_rules": {
      "type": "object",
      "properties": {
        "priority_order": { "type": "array", "items": { "type": "string" } },
        "natural_language_examples": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "user_input": { "type": "string" },
              "route_to": { "type": "string" }
            }
          }
        }
      }
    },
    "directory_permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "flow_code": { "type": "string" },
          "allowed_dirs": { "type": "array", "items": { "type": "string" } },
          "forbidden_dirs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "non_bypass_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule": { "type": "string" },
          "severity": { "type": "string", "enum": ["BLOCK", "WARN"] },
          "description": { "type": "string" }
        }
      }
    }
  }
}
