{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flow Routes Schema",
  "description": "流程路由表的 schema 定义 — 承接 FLOW_流程路由与阶段门_v1.0.md",
  "type": "object",
  "required": ["version", "description", "flows", "routing_rules", "directory_permissions", "non_bypass_rules"],
  "properties": {
    "version": { "type": "string" },
    "description": { "type": "string" },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["flow_code", "name", "applicable_scenes", "priority", "stages"],
        "properties": {
          "flow_code": { "type": "string", "pattern": "^F-[A-Z]+$" },
          "name": { "type": "string" },
          "applicable_scenes": { "type": "array", "items": { "type": "string" } },
          "priority": { "type": "integer" },
          "stages": {
            "type": "object",
            "properties": {
              "required_gates": { "type": "array", "items": { "type": "string" } },
              "default_path": { "type": "string" }
            }
          }
        }
      }
    },
    "routing_rules": {
      "type": "object",
      "properties": {
        "priority_order": { "type": "array", "items": { "type": "string" } },
        "natural_language_examples": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "user_input": { "type": "string" },
              "route_to": { "type": "string" }
            }
          }
        }
      }
    },
    "directory_permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "flow_code": { "type": "string" },
          "allowed_dirs": { "type": "array", "items": { "type": "string" } },
          "forbidden_dirs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "non_bypass_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule": { "type": "string" },
          "severity": { "type": "string", "enum": ["BLOCK", "WARN"] },
          "description": { "type": "string" }
        }
      }
    },
    "g0_g6_routing_contract": {
      "type": "object",
      "required": [
        "version",
        "purpose",
        "default_langgraph",
        "langgraph_enable_condition",
        "priority_order",
        "issue_routes",
        "decision_states",
        "routing_output_required_fields"
      ],
      "properties": {
        "version": {"type": "string"},
        "purpose": {"type": "string"},
        "default_langgraph": {"type": "boolean"},
        "langgraph_enable_condition": {"type": "string"},
        "priority_order": {"type": "array", "items": {"type": "string"}},
        "issue_routes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["flow_code", "keywords", "required_roles", "must_have_gates", "block_if_missing_roles"],
            "properties": {
              "flow_code": {"type": "string"},
              "keywords": {"type": "array", "items": {"type": "string"}},
              "required_roles": {"type": "array", "items": {"type": "string"}},
              "must_have_gates": {"type": "array", "items": {"type": "string"}},
              "block_if_missing_roles": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "decision_states": {
          "type": "object",
          "required": ["PASS", "WARN", "BLOCK"]
        },
        "routing_output_required_fields": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    }
  }
}
