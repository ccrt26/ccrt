{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "stock_today_decision_view.schema.json",
  "title": "StockTodayDecisionView",
  "description": "面向用户的第一屏后端契约。展示股票走势、持仓、盈亏、人话分析、技术证据和次日决策。不暴露后台工程细节。",
  "type": "object",
  "required": [
    "view_id", "stock_code", "stock_name", "trade_date",
    "as_of_time", "market_today", "plain_language_summary",
    "technical_evidence", "decision_for_next_day",
    "user_visible_status", "updated_at"
  ],
  "properties": {
    "view_id": {
      "type": "string"
    },
    "stock_code": {
      "type": "string"
    },
    "stock_name": {
      "type": "string"
    },
    "trade_date": {
      "type": "string",
      "pattern": "^[0-9]{8}$"
    },
    "as_of_time": {
      "type": "string",
      "format": "date-time"
    },
    "user_position": {
      "type": "object",
      "description": "用户持仓信息",
      "properties": {
        "has_position": { "type": "boolean" },
        "quantity": { "type": ["number", "null"] },
        "cost_price": { "type": ["number", "null"] },
        "market_price": { "type": ["number", "null"] },
        "market_value": { "type": ["number", "null"] },
        "unrealized_pnl": { "type": ["number", "null"] },
        "unrealized_pnl_pct": { "type": ["number", "null"] },
        "position_weight": { "type": ["number", "null"] },
        "position_source": { "type": "string" },
        "position_as_of": { "type": "string", "format": "date-time" }
      },
      "required": ["has_position"]
    },
    "market_today": {
      "type": "object",
      "description": "今日市场数据",
      "properties": {
        "open": { "type": ["number", "null"] },
        "high": { "type": ["number", "null"] },
        "low": { "type": ["number", "null"] },
        "close": { "type": ["number", "null"] },
        "change_pct": { "type": ["number", "null"] },
        "volume": { "type": ["number", "null"] },
        "turnover": { "type": ["number", "null"] },
        "intraday_pattern": { "type": "string" },
        "relative_to_support": { "type": "string" },
        "relative_to_pressure": { "type": "string" },
        "relative_to_stop_loss": { "type": "string" },
        "sector_phase": { "type": "string" },
        "fund_flow_summary": { "type": "string" },
        "data_freshness_status": { "type": "string" }
      },
      "required": ["close", "change_pct", "data_freshness_status"]
    },
    "plain_language_summary": {
      "type": "object",
      "description": "人话分析摘要",
      "properties": {
        "pattern_type": { "type": "string" },
        "key_position": { "type": "string" },
        "volume_status": { "type": "string" },
        "fund_status": { "type": "string" },
        "sector_status": { "type": "string" },
        "system_judgment": { "type": "string" },
        "data_sufficient": { "type": "boolean" }
      },
      "required": ["system_judgment", "data_sufficient"]
    },
    "technical_evidence": {
      "type": "object",
      "description": "技术证据",
      "properties": {
        "ma5": { "type": ["number", "null"] },
        "ma10": { "type": ["number", "null"] },
        "ma20": { "type": ["number", "null"] },
        "ma60": { "type": ["number", "null"] },
        "rsi": { "type": ["number", "null"] },
        "macd": { "type": "object", "properties": {
          "dif": { "type": ["number", "null"] },
          "dea": { "type": ["number", "null"] },
          "hist": { "type": ["number", "null"] }
        }},
        "volume_ratio": { "type": ["number", "null"] },
        "support_levels": {
          "type": "array",
          "items": { "type": "number" }
        },
        "pressure_levels": {
          "type": "array",
          "items": { "type": "number" }
        },
        "stop_loss": { "type": ["number", "null"] },
        "risk_light": { "type": "string", "enum": ["GREEN", "YELLOW", "RED", "UNKNOWN"] },
        "fund_flow_4level": { "type": "string" },
        "sector_phase": { "type": "string" },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "chart_refs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "图表数据引用路径"
    },
    "baseline_refs": {
      "type": "object",
      "properties": {
        "baseline_id": { "type": "string" },
        "baseline_date": { "type": "string" }
      }
    },
    "decision_for_next_day": {
      "type": "object",
      "description": "次日决策",
      "properties": {
        "primary_action": { "type": "string", "enum": [
          "hold", "observe", "reduce_position", "stop_loss",
          "wait_for_add", "forbidden"
        ]},
        "position_suggestion": { "type": "string" },
        "stop_loss": { "type": ["number", "null"] },
        "take_profit_or_pressure": { "type": ["number", "null"] },
        "observe_conditions": { "type": "string" },
        "forbidden_actions": { "type": "string" },
        "trigger_if_up": { "type": "string" },
        "trigger_if_down": { "type": "string" },
        "trigger_if_flat": { "type": "string" },
        "reason_codes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "required": ["primary_action", "confidence"]
    },
    "decision_blockers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "user_visible_status": {
      "type": "string",
      "enum": ["COMPLETE", "AUTO_REPAIRING", "BLOCK"]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
