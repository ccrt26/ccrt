{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AnalysisRunState",
  "description": "记录每只股票每日分析运行状态：是否完成、结论是否可用、失败原因、数据是否过期、是否需要重跑。",
  "type": "object",
  "required": ["stock_code", "trade_date", "run_id", "run_status", "updated_at"],
  "properties": {
    "stock_code": {"type": "string"},
    "stock_name": {"type": "string"},
    "trade_date": {"type": "string", "pattern": "^[0-9]{8}$"},
    "run_id": {"type": "string"},
    "run_status": {"type": "string", "enum": ["PENDING", "RUNNING", "PASS", "WARN", "ALERT", "BLOCK"]},
    "data_status": {"type": "string", "enum": ["FRESH", "STALE", "MISSING", "UNKNOWN"]},
    "decision_status": {"type": "string", "enum": ["AVAILABLE", "STALE", "BLOCKED", "UNKNOWN"]},
    "evidence_status": {"type": "string", "enum": ["COMPLETE", "PARTIAL", "MISSING", "UNKNOWN"]},
    "rule_health_status": {"type": "string", "enum": ["GREEN", "YELLOW", "RED", "UNKNOWN"]},
    "stale_flags": {"type": "array", "items": {"type": "string"}},
    "blocking_reasons": {"type": "array", "items": {"type": "string"}},
    "warning_reasons": {"type": "array", "items": {"type": "string"}},
    "last_success_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
