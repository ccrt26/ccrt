{
  "registry": "rule_asset_registry",
  "version": "1.0",
  "status": "draft",
  "description": "规则资产注册表骨架。字段定义基于 P0-B design 方案，不启动规则拆条。",
  "meta": {
    "id_format": "R-{前缀}-{4位序号}",
    "type_enum": [
      "fin",
      "redline",
      "coding",
      "role",
      "analysis",
      "report",
      "dict",
      "process",
      "version",
      "constitution",
      "deploy"
    ],
    "exec_grade_enum": [
      "M",
      "H",
      "A"
    ],
    "status_enum": [
      "active",
      "deprecated",
      "retired",
      "pending_review"
    ],
    "reference_method_enum": [
      "rule_id",
      "direct_read",
      "script_call"
    ]
  },
  "field_definitions": {
    "rule_id": {
      "type": "string",
      "pattern": "^R-(FIN|RED|COD|ROL|ANL|RPT|DCT|PRC|VER|CST|DEP)-[0-9]{4}$",
      "required": true
    },
    "name": {
      "type": "string",
      "max_length": 64,
      "required": true
    },
    "type": {
      "type": "enum",
      "values": [
        "fin",
        "redline",
        "coding",
        "role",
        "analysis",
        "report",
        "dict",
        "process",
        "version",
        "constitution",
        "deploy"
      ],
      "required": true
    },
    "owner": {
      "type": "string",
      "required": true
    },
    "source_file": {
      "type": "string",
      "required": true
    },
    "source_line": {
      "type": "string",
      "required": false
    },
    "scope": {
      "type": "array",
      "items": "string",
      "required": true
    },
    "exec_grade": {
      "type": "enum",
      "values": [
        "M",
        "H",
        "A"
      ],
      "required": true
    },
    "gate_ref": {
      "type": "string",
      "required": false
    },
    "reference_method": {
      "type": "enum",
      "values": [
        "rule_id",
        "direct_read",
        "script_call"
      ],
      "required": true
    },
    "version": {
      "type": "string",
      "required": true
    },
    "status": {
      "type": "enum",
      "values": [
        "active",
        "deprecated",
        "retired",
        "pending_review"
      ],
      "required": true
    },
    "audit_required": {
      "type": "boolean",
      "required": true
    },
    "conflict_with": {
      "type": "array",
      "items": "rule_id",
      "required": false
    },
    "depends_on": {
      "type": "array",
      "items": "rule_id",
      "required": false
    },
    "description": {
      "type": "string",
      "max_length": 256,
      "required": true
    }
  },
