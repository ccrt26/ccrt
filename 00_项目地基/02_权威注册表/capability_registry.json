{
  "registry": "capability_registry",
  "version": "1.0",
  "status": "draft",
  "description": "原子能力注册表骨架。字段定义基于 P0-B design 方案，不注册真实能力。",
  "meta": {
    "id_format": "C-D{域编号}-{4位序号}",
    "domain_enum": ["D01","D02","D03","D04","D05","D06","D07","D08","D09","D10","D11","D12"],
    "status_enum": ["active","deprecated","retired"],
    "cost_profile_structure": { "token": "integer", "api": "integer", "time": "string" }
  },
  "field_definitions": {
    "capability_id":  { "type": "string", "pattern": "^C-D(0[1-9]|1[0-2])-[0-9]{4}$", "required": true },
    "name":           { "type": "string", "max_length": 64, "required": true },
    "domain":         { "type": "enum", "values": ["D01","D02","D03","D04","D05","D06","D07","D08","D09","D10","D11","D12"], "required": true },
    "owner":          { "type": "string", "required": true },
    "executor":       { "type": "string", "required": true },
    "inputs":         { "type": "array", "items": "string", "required": true },
    "outputs":        { "type": "array", "items": "string", "required": true },
    "interface":      { "type": "string", "required": true },
    "rules_applied":  { "type": "array", "items": "rule_id", "required": true },
    "dependencies":   { "type": "array", "items": "capability_id", "required": false },
    "cost_profile":   { "type": "object", "properties": { "token": "integer", "api": "integer", "time": "string" }, "required": true },
    "audit_required": { "type": "boolean", "required": true },
    "status":         { "type": "enum", "values": ["active","deprecated","retired"], "required": true },
    "version":        { "type": "string", "required": true }
  },
  "_note_scene_pending": "场景编排能力调用配置尚未注册为独立能力条目。当前按四大业务主场景治理：重点股票分析（含深度分析/日报/临时分析）、每日荐股、保护机制、模拟交易。场景调用矩阵已整合至 00_项目地基/05_流程与角色/role_matrix.json（flow_role_mapping）和 00_项目地基/05_流程与角色/stage_gate_policy.json（typical_paths）。统一解读是 D07 原子能力 C-D07-0001，不是业务场景。待 D02/D04/D08-D12 能力注册后，再补充 D09 场景编排能力注册。原始说明保留于 CAP_能力场景与规则接入_v1.0.md。",
