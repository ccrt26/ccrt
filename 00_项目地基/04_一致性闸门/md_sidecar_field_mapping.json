    {"id": "D3", "field": "fund_flow.medium_net", "md_source": "资金表中单", "sidecar_path": "$.fund_flow_4level.medium_net", "type": "amount_wan", "tolerance": "1.0"},
    {"id": "D4", "field": "fund_flow.small_net", "md_source": "资金表小单", "sidecar_path": "$.fund_flow_4level.small_net", "type": "amount_wan", "tolerance": "1.0"},
    {"id": "D5", "field": "fund_flow.main_force_net", "md_source": "资金表主力合计", "sidecar_path": "$.fund_flow_4level.main_force_net", "type": "amount_wan", "tolerance": "1.0"},
    {"id": "E1", "field": "sector_phase.phase", "md_source": "板块相位", "sidecar_path": "$.sector_phase.phase", "type": "string", "tolerance": "exact"},
