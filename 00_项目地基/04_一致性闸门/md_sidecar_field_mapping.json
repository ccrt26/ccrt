    {"id": "F2", "field": "risk_light.machine", "md_source": "综合灯(machine)", "sidecar_path": "$.machine_fields.risk_light", "type": "string", "tolerance": "exact"},
    {"id": "G1", "field": "eval_hooks.t1_verify", "md_source": "T+1验证", "sidecar_path": "$.eval_hooks.t1_verify", "type": "string", "tolerance": "keyword"},
    {"id": "G2", "field": "eval_hooks.t5_verify", "md_source": "T+5验证", "sidecar_path": "$.eval_hooks.t5_verify", "type": "string", "tolerance": "keyword"},
    {"id": "H1", "field": "mirror.report_version", "sidecar_path": "$.report_version vs $.machine_fields.report_version", "type": "mirror", "tolerance": "exact"},
    {"id": "H2", "field": "mirror.stock_code", "sidecar_path": "$.stock_code vs $.machine_fields.stock_code", "type": "mirror", "tolerance": "exact"},
    {"id": "H3", "field": "mirror.trade_date", "sidecar_path": "$.trade_date vs $.machine_fields.trade_date", "type": "mirror", "tolerance": "date_equiv"},
    {"id": "H4", "field": "mirror.action_change", "sidecar_path": "$.action_change vs $.p0_decision_card.action_change vs $.machine_fields.action_change", "type": "mirror", "tolerance": "exact"},
    {"id": "H5", "field": "mirror.p0_action", "sidecar_path": "$.p0_decision_card.t1_action vs $.machine_fields.p0_action", "type": "mirror", "tolerance": "exact"},
    {"id": "H6", "field": "mirror.confidence", "sidecar_path": "$.p0_decision_card.confidence_level vs $.machine_fields.confidence", "type": "mirror", "tolerance": "exact"},
    {"id": "H7", "field": "mirror.risk_light", "sidecar_path": "$.risk_light.overall vs $.machine_fields.risk_light", "type": "mirror", "tolerance": "exact"}
  ]
