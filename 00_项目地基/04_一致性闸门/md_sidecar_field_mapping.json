{
  "version": "1.0",
  "description": "P0-D MD 与 sidecar JSON 字段映射表。记录同一份日报中 MD（Markdown 正文）与 JSON sidecar 之间的字段对应关系。",
  "created": "2026-06-02",
  "mappings": [
    {"id": "A1", "field": "stock_code", "md_source": "路径/标题", "sidecar_path": "$.stock_code", "type": "string", "tolerance": "exact"},
    {"id": "A2", "field": "stock_name", "md_source": "路径/标题", "sidecar_path": "$.stock_name", "type": "string", "tolerance": "exact"},
    {"id": "A3", "field": "trade_date", "md_source": "头部日期", "sidecar_path": "$.trade_date", "type": "date", "tolerance": "exact"},
    {"id": "A4", "field": "baseline_id", "md_source": "baseline_id：xxx", "sidecar_path": "$.baseline_id", "type": "string", "tolerance": "exact"},
    {"id": "B1", "field": "p0.t1_action", "md_source": "明日主动作", "sidecar_path": "$.p0_decision_card.t1_action", "type": "enum", "tolerance": "action_compat"},
    {"id": "B2", "field": "p0.current_position_cap", "md_source": "当前仓位上限", "sidecar_path": "$.p0_decision_card.current_position_cap", "type": "pct_str", "tolerance": "0.01"},
    {"id": "B3", "field": "p0.triggered_position_cap", "md_source": "条件触发后仓位", "sidecar_path": "$.p0_decision_card.triggered_position_cap", "type": "string", "tolerance": "keyword_match"},
