    {"id": "B5", "field": "p0.new_position_stop_loss", "md_source": "新仓止损", "sidecar_path": "$.p0_decision_card.new_position_stop_loss", "type": "price_extract", "tolerance": "0.01"},
    {"id": "B6", "field": "p0.held_position_stop_loss", "md_source": "已持仓止损", "sidecar_path": "$.p0_decision_card.held_position_stop_loss", "type": "price_extract", "tolerance": "0.01"},
    {"id": "B7", "field": "p0.forbidden_actions", "md_source": "禁止动作/不做清单", "sidecar_path": "$.p0_decision_card.forbidden_actions", "type": "list", "tolerance": "semantic"},
    {"id": "B8", "field": "p0.confidence_level", "md_source": "置信度", "sidecar_path": "$.p0_decision_card.confidence_level", "type": "enum_high_med_low", "tolerance": "exact"},
    {"id": "B9", "field": "p0.one_line_conclusion", "md_source": "一句话结论/明日一句话操作", "sidecar_path": "$.p0_decision_card.one_line_conclusion", "type": "string", "tolerance": "action_keyword"},
    {"id": "C1", "field": "delta.close", "md_source": "今天行情收盘", "sidecar_path": "$.delta.close", "type": "float", "tolerance": "0.001"},
    {"id": "C2", "field": "delta.change_pct", "md_source": "上涨/下跌 x%", "sidecar_path": "$.delta.change_pct", "type": "float", "tolerance": "0.05"},
    {"id": "C3", "field": "delta.volume_wan_shou", "md_source": "今天行情成交量", "sidecar_path": "$.delta.volume_wan_shou", "type": "float", "tolerance": "1.0"},
