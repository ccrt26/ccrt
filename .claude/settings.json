{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(*.py) || Bash(python *)",
        "command": "python3 \"/Users/ccrt/ccrt/代码文件/监督机制/PreToolUse_hook.py\""
      },
      {
        "matcher": "Edit(*) || Write(*)",
        "command": "python3 \"/Users/ccrt/ccrt/代码文件/监督机制/write_protection_hook.py\""
      }
    ]
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(*.py)",
      "Bash(python3 *)",
      "Skill(update-config)",
      "Skill(fewer-permission-prompts)",
      "WebSearch",
      "WebFetch",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep"
    ]
  },
  "mcpServers": {
    "tielv-financial": {
      "command": "python3",
      "args": ["/Users/ccrt/ccrt/代码文件/tools/financial_mcp_server.py"]
    }
  }
}
