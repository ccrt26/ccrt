{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit(*) || Write(*) || MultiEdit(*)",
        "command": "python3 \"/Users/ccrt/ccrt/代码文件/监督机制/write_protection_hook.py\""
      },
      {
        "matcher": "Bash(*)",
        "command": "python3 \"/Users/ccrt/ccrt/代码文件/监督机制/write_protection_hook.py\""
      },
      {
        "matcher": "Read(*)",
        "command": "python3 \"/Users/ccrt/ccrt/代码文件/监督机制/write_protection_hook.py\""
      }
    ]
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(*)",
      "Skill(update-config)",
      "Skill(fewer-permission-prompts)",
      "WebSearch",
      "WebFetch",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep"
    ]
  },
  "env": {
    "BIYING_LICENCE": "8025D388-5DEB-42C0-9084-E4EEB378654F"
  },
  "mcpServers": {
    "tielv-financial": {
      "command": "python3",
      "args": ["/Users/ccrt/ccrt/代码文件/tools/financial_mcp_server.py"]
    }
  }
}
