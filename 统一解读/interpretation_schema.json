{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tielv-quant.ccrt/interpretation_schema.json",
  "title": "统一解读对象 Schema",
  "description": "铁律量化项目所有分析产出的解释对象标准格式 v1.0",
  "type": "object",
  "required": [
    "interpretation_id",
    "scene",
    "stock_code",
    "trade_date",
    "role",
    "data_fact",
    "interpretation_hypothesis",
    "supporting_evidence",
    "counter_evidence",
    "investment_implication",
    "action_bias",
    "confidence",
    "invalidation_condition",
    "eval_window",
    "rule_refs",
    "knowledge_refs"
  ],
  "properties": {
    "interpretation_id": {
      "type": "string",
      "pattern": "^INT-[0-9]{8}-[0-9]{6}-[a-z0-9]{6}$",
      "description": "唯一标识，格式 INT-YYYYMMDD-HHMMSS-随机6位"
    },
    "scene": {
      "type": "string",
      "enum": ["日报", "深度分析", "每日荐股", "模拟交易", "保护机制", "临时分析"],
      "description": "分析场景"
    },
    "stock_code": {
      "type": "string",
      "pattern": "^(MARKET|[0-9]{6}|[0-9]{6}\\.[A-Z]{2,4})$",
      "description": "股票代码，非个股场景填MARKET"
    },
    "trade_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "交易日期 YYYY-MM-DD"
    },
    "role": {
      "type": "string",
      "enum": ["腰子", "山猫", "信鸽", "玉夜", "流金", "青山", "砺石"],
      "description": "生成角色"
    },
    "data_fact": {
      "type": "object",
      "description": "数据事实包。⛔ 禁止含投资结论性语言（如'建议''看好''推荐'），违者WARN退回。为空→BLOCK",
      "required": ["source", "freshness", "values"],
      "properties": {
        "source": {
          "type": "string",
          "description": "数据来源标识"
        },
        "freshness": {
          "type": "string",
          "enum": ["实时", "当日", "T+1", "T+2", "周度", "月度", "季度", "未知"],
          "description": "数据新鲜度"
        },
        "completeness": {
          "type": "string",
          "enum": ["完整", "部分缺失", "严重缺失"],
          "description": "数据完整性"
        },
        "degradation": {
          "type": "string",
          "enum": ["无降级", "L1降级", "L2降级", "L3降级"],
          "description": "数据降级路径"
        },
        "anomalies": {
          "type": "array",
          "items": {"type": "string"},
          "description": "异常值列表"
        },
        "values": {
          "type": "object",
          "description": "关键数据值，如 PE/price/volume/fund_flow 等",
          "additionalProperties": true
        },
        "note": {
          "type": "string",
          "description": "补充说明（仅描述事实，不含结论）"
        }
      }
    },
    "interpretation_hypothesis": {
      "type": "string",
      "minLength": 20,
      "description": "投资含义假说，至少20字"
    },
    "supporting_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["evidence", "source", "strength", "source_level", "source_ref"],
        "properties": {
          "evidence": {"type": "string", "minLength": 10},
          "source": {"type": "string"},
          "strength": {"type": "string", "enum": ["强", "中", "弱"]},
          "source_level": {"type": "string", "enum": ["L1", "L2", "L3", "L4", "L5", "L5-seed"], "description": "来源等级"},
          "source_ref": {"type": "string", "minLength": 5, "description": "来源引用路径"}
        }
      },
      "description": "支持证据，至少1条"
    },
    "counter_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["evidence", "source", "type"],
        "properties": {
          "evidence": {"type": "string", "minLength": 10},
          "source": {"type": "string"},
          "type": {"type": "string", "enum": ["宏观风险", "技术面反证", "基本面反证", "资金面反证", "事件风险", "流动性风险", "其他"]}
        }
      },
      "description": "反证，为空→BLOCK。仅有一条且为套话（如仅填'市场风险'）→WARN"
    },
    "investment_implication": {
      "type": "string",
      "minLength": 20,
      "description": "投资含义，为空→BLOCK"
    },
    "action_bias": {
      "type": "string",
      "enum": ["BUY", "HOLD", "SELL", "WATCH", "NEUTRAL"],
      "description": "动作偏向"
    },
    "trigger_condition": {
      "type": "string",
      "description": "触发条件。action_bias为BUY或SELL时必填，否则→BLOCK"
    },
    "price_range": {
      "type": "string",
      "description": "价格区间"
    },
    "position_limit": {
      "type": "string",
      "description": "仓位上限"
    },
    "time_window": {
      "type": "string",
      "description": "时间窗口"
    },
    "confidence": {
      "type": "string",
      "enum": ["HIGH", "MEDIUM", "LOW"],
      "description": "置信度。LOW + 强动作(BUY/SELL) → BLOCK"
    },
    "invalidation_condition": {
      "type": "string",
      "minLength": 15,
      "description": "失效条件，为空→BLOCK。必须具体可验证"
    },
    "eval_window": {
      "type": "object",
      "required": ["t1", "t3", "t5"],
      "properties": {
        "t1": {"type": "string", "description": "T+1 检查项"},
        "t3": {"type": "string", "description": "T+3 检查项"},
        "t5": {"type": "string", "description": "T+5 检查项"}
      },
      "description": "后评估窗口，T+1/T+3/T+5检查项"
    },
    "rule_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"},
      "description": "引用的铁律规则编号，至少1条"
    },
    "knowledge_refs": {
      "type": "array",
      "items": {"type": "string"},
      "description": "引用的知识库条目"
    },
    "method_review": {
      "type": "object",
      "description": "砺石方法审查输出（可选字段，按需唤醒时填写）",
      "required": ["role", "role_code", "result"],
      "properties": {
        "role": {
          "type": "string",
          "const": "砺石",
          "description": "角色名"
        },
        "role_code": {
          "type": "string",
          "const": "LISHI",
          "description": "角色代码"
        },
        "result": {
          "type": "string",
          "enum": ["PASS", "WARN", "BLOCK"],
          "description": "方法审查结论"
        },
        "main_challenge": {
          "type": "string",
          "description": "主要质疑点（result=BLOCK时必填）"
        },
        "check_item": {
          "type": "string",
          "description": "本次审查项描述（最大隐含假设/最强反证等）"
        },
        "confidence_adjustment": {
          "type": "string",
          "enum": ["NONE", "HIGH_TO_MEDIUM", "MEDIUM_TO_LOW"],
          "description": "置信度调整建议"
        },
        "adjustment_reason": {
          "type": "string",
          "description": "调整原因（confidence_adjustment != NONE时必填）"
        },
        "action_adjustment": {
          "type": "string",
          "enum": ["NONE", "BUY_TO_WATCH", "SELL_TO_WATCH"],
          "description": "动作方向调整建议（仅作参考，不强制执行）"
        },
        "rejected_reason": {
          "type": "string",
          "description": "腰子驳回砺石质疑的理由"
        }
      }
    }
  },

  "allOf": [
    {
      "if": {
        "properties": {
          "action_bias": {"enum": ["BUY", "SELL"]}
        }
      },
      "then": {
        "required": ["trigger_condition", "price_range", "position_limit", "time_window"]
      }
    }
  ],

  "硬规则注释": {
    "R1_缺data_fact": "BLOCK — required字段，JSON Schema自动拦截",
    "R2_缺counter_evidence": "BLOCK — minItems:1 + required，JSON Schema自动拦截",
    "R3_缺investment_implication": "BLOCK — required字段",
    "R4_缺invalidation_condition": "BLOCK — required字段",
    "R5_强动作无触发条件": "BLOCK — allOf条件：BUY/SELL时require trigger/price/position/time",
    "R6_低置信强动作": "BLOCK — 需代码层面检查 confidence=LOW + action_bias in (BUY,SELL)",
    "R7_data_fact含结论": "WARN — 需代码层面正则检查（建议/看好/推荐等词）",
    "R8_反证套话": "WARN — 需代码层面检查 counter_evidence仅1条且evidence匹配套话模式",
    "R9_method_review_role_code": "BLOCK — method_review存在时 role_code 必须为 LISHI",
    "R10_method_review_result": "WARN — result 不在 PASS/WARN/BLOCK 范围",
    "R11_method_review_BLOCK缺质疑": "WARN — result=BLOCK 但 main_challenge 为空",
    "R12_置信度调整缺原因": "WARN — confidence_adjustment != NONE 但 adjustment_reason 为空",
    "R13_动作方向调整缺质疑": "WARN — action_adjustment != NONE 但 main_challenge 为空"
  }
}
