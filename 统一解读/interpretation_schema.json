{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tielv-quant.ccrt/interpretation_schema.json",
  "title": "统一解读对象 Schema",
  "description": "铁律量化项目所有分析产出的解释对象标准格式 v1.0",
  "type": "object",
  "required": [
    "interpretation_id",
    "scene",
    "stock_code",
    "trade_date",
    "role",
    "data_fact",
    "interpretation_hypothesis",
    "supporting_evidence",
    "counter_evidence",
    "investment_implication",
    "action_bias",
    "confidence",
    "invalidation_condition",
    "eval_window",
    "rule_refs",
    "knowledge_refs"
  ],
  "properties": {
    "interpretation_id": {
      "type": "string",
      "pattern": "^INT-[0-9]{8}-[0-9]{6}-[a-z0-9]{6}$",
      "description": "唯一标识，格式 INT-YYYYMMDD-HHMMSS-随机6位"
    },
    "scene": {
      "type": "string",
      "enum": ["日报", "深度分析", "每日荐股", "模拟交易", "保护机制", "临时分析"],
      "description": "分析场景"
    },
    "stock_code": {
      "type": "string",
      "pattern": "^(MARKET|[0-9]{6}|[0-9]{6}\\.[A-Z]{2,4})$",
      "description": "股票代码，非个股场景填MARKET"
    },
    "trade_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "交易日期 YYYY-MM-DD"
    },
    "role": {
      "type": "string",
      "enum": ["腰子", "山猫", "信鸽", "玉夜", "流金", "青山"],
      "description": "生成角色"
    },
    "data_fact": {
      "type": "object",
      "description": "数据事实包。⛔ 禁止含投资结论性语言（如'建议''看好''推荐'），违者WARN退回。为空→BLOCK",
      "required": ["source", "freshness", "values"],
      "properties": {
        "source": {
          "type": "string",
          "description": "数据来源标识"
        },
        "freshness": {
          "type": "string",
          "enum": ["实时", "当日", "T+1", "T+2", "周度", "月度", "季度", "未知"],
          "description": "数据新鲜度"
        },
        "completeness": {
          "type": "string",
          "enum": ["完整", "部分缺失", "严重缺失"],
          "description": "数据完整性"
        },
        "degradation": {
          "type": "string",
          "enum": ["无降级", "L1降级", "L2降级", "L3降级"],
          "description": "数据降级路径"
        },
        "anomalies": {
          "type": "array",
          "items": {"type": "string"},
          "description": "异常值列表"
        },
        "values": {
          "type": "object",
          "description": "关键数据值，如 PE/price/volume/fund_flow 等",
          "additionalProperties": true
        },
        "note": {
          "type": "string",
          "description": "补充说明（仅描述事实，不含结论）"
        }
      }
    },
    "interpretation_hypothesis": {
      "type": "string",
      "minLength": 20,
      "description": "投资含义假说，至少20字"
    },
    "supporting_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["evidence", "source", "strength", "source_level", "source_ref"],
        "properties": {
          "evidence": {"type": "string", "minLength": 10},
          "source": {"type": "string"},
          "strength": {"type": "string", "enum": ["强", "中", "弱"]},
          "source_level": {"type": "string", "enum": ["L1", "L2", "L3", "L4", "L5", "L5-seed"], "description": "来源等级"},
          "source_ref": {"type": "string", "minLength": 5, "description": "来源引用路径"}
        }
      },
      "description": "支持证据，至少1条"
    },
    "counter_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["evidence", "source", "type"],
        "properties": {
          "evidence": {"type": "string", "minLength": 10},
          "source": {"type": "string"},
          "type": {"type": "string", "enum": ["宏观风险", "技术面反证", "基本面反证", "资金面反证", "事件风险", "流动性风险", "其他"]}
        }
      },
      "description": "反证，为空→BLOCK。仅有一条且为套话（如仅填'市场风险'）→WARN"
    },
    "investment_implication": {
      "type": "string",
      "minLength": 20,
      "description": "投资含义，为空→BLOCK"
    },
    "action_bias": {
      "type": "string",
      "enum": ["BUY", "HOLD", "SELL", "WATCH", "NEUTRAL"],
      "description": "动作偏向"
    },
    "trigger_condition": {
      "type": "string",
      "description": "触发条件。action_bias为BUY或SELL时必填，否则→BLOCK"
    },
    "price_range": {
      "type": "string",
      "description": "价格区间"
    },
    "position_limit": {
      "type": "string",
      "description": "仓位上限"
    },
    "time_window": {
      "type": "string",
      "description": "时间窗口"
    },
    "confidence": {
      "type": "string",
      "enum": ["HIGH", "MEDIUM", "LOW"],
      "description": "置信度。LOW + 强动作(BUY/SELL) → BLOCK"
    },
    "invalidation_condition": {
      "type": "string",
      "minLength": 15,
      "description": "失效条件，为空→BLOCK。必须具体可验证"
    },
    "eval_window": {
      "type": "object",
      "required": ["t1", "t3", "t5"],
      "properties": {
        "t1": {"type": "string", "description": "T+1 检查项"},
        "t3": {"type": "string", "description": "T+3 检查项"},
        "t5": {"type": "string", "description": "T+5 检查项"}
      },
      "description": "后评估窗口，T+1/T+3/T+5检查项"
    },
    "rule_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"},
      "description": "引用的铁律规则编号，至少1条"
    },
    "knowledge_refs": {
      "type": "array",
      "items": {"type": "string"},
      "description": "引用的知识库条目"
    },
    "framework_version": {
      "type": "string",
      "enum": ["D07_v1.0", "D07_v1.1", "D07_v1.2"],
      "description": "分析框架版本。D07_v1.2 触发多假设、证据缺口、长期机构资金等增强校验。"
    },
    "hypotheses": {
      "type": "array",
      "description": "多假设阵列。D07_v1.2 场景下至少 2 条；涉交易动作时必须含反向假设。",
      "items": {
        "type": "object",
        "required": ["hypothesis_id", "statement", "status", "conclusion_strength"],
        "properties": {
          "hypothesis_id": {"type": "string", "description": "假设标识，如 H1/H2/反向假设"},
          "statement": {"type": "string", "minLength": 10, "description": "假设描述"},
          "status": {"type": "string", "enum": ["active", "weakened", "rejected", "pending_evidence"],
                      "description": "假设状态"},
          "supporting_evidence_refs": {"type": "array", "items": {"type": "string"},
                                        "description": "支持证据引用标识"},
          "counter_evidence_refs": {"type": "array", "items": {"type": "string"},
                                     "description": "反证引用标识"},
          "conclusion_strength": {"type": "string", "enum": ["可定性", "倾向判断", "风险假设", "数据不足"],
                                   "description": "该假设的结论强度"},
          "missing_data": {"type": "string", "description": "缺什么数据会影响结论"}
        }
      }
    },
    "evidence_gap_requests": {
      "type": "array",
      "description": "证据缺口申请。P1 原始披露未闭合时必须至少包含一条 open gap。",
      "items": {
        "type": "object",
        "required": ["gap_id", "gap_type", "description", "status"],
        "properties": {
          "gap_id": {"type": "string", "description": "证据缺口唯一标识"},
          "gap_type": {"type": "string", "enum": ["original_disclosure_missing", "field_missing", "freshness_unknown",
                       "source_conflict", "sample_insufficient", "other"],
                       "description": "缺口类型"},
          "description": {"type": "string", "minLength": 10, "description": "缺口说明"},
          "requested_source": {"type": "array", "items": {"type": "string"},
                                "description": "期望补充的来源"},
          "requested_fields": {"type": "array", "items": {"type": "string"},
                                "description": "期望补充的字段"},
          "status": {"type": "string", "enum": ["open", "resolved", "waived_with_reason"],
                      "description": "缺口状态"},
          "impact": {"type": "string", "description": "缺口对结论的影响"},
          "owner_role_hint": {"type": "string", "description": "负责角色提示"}
        }
      }
    },
    "long_term_institutional_evidence": {
      "type": "object",
      "description": "社保/养老金/长期机构资金证据。不使用时可缺省；使用时每条 record 必须含 limitation_note。",
      "properties": {
        "status": {"type": "string", "enum": ["not_applicable", "present", "gap_requested"],
                    "description": "长期机构资金证据整体状态"},
        "p1_verification_status": {"type": "string", "enum": ["verified", "warn_pending", "not_applicable"],
                                    "description": "P1 原始披露验真状态"},
        "signal_usage": {"type": "string", "enum": ["中期逻辑支持", "机构分歧", "风险反证", "仅背景"],
                          "description": "该证据在分析中的角色"},
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["report_period", "shareholder_name_raw", "institution_type", "source_refs", "limitation_note"],
            "properties": {
              "report_period": {"type": "string", "description": "报告期"},
              "disclosure_date": {"type": "string", "description": "披露日期"},
              "shareholder_name_raw": {"type": "string", "description": "原始股东名称，须保留原文"},
              "institution_type": {"type": "string", "enum": ["全国社保基金", "基本养老保险基金", "企业年金", "险资", "公募", "其他"],
                                    "description": "机构类型"},
              "holding_rank": {"type": "integer", "description": "前十大排名；退出/未披露时缺省"},
              "share_count": {"type": "number", "description": "持股数量，单位：股"},
              "share_ratio": {"type": "number", "description": "持股比例，小数格式"},
              "change_type": {"type": "string", "enum": ["新进", "增持", "减持", "持平", "退出披露名单", "无法判断"],
                               "description": "变动类型"},
              "consecutive_periods": {"type": "integer", "description": "连续出现报告期数"},
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["source_name", "source_level"],
                  "properties": {
                    "source_name": {"type": "string", "description": "来源名称"},
                    "source_url": {"type": "string", "description": "来源 URL"},
                    "source_level": {"type": "string", "enum": ["original_disclosure", "exchange_announcement",
                                     "secondary_organization", "index_reference", "pending_review"],
                                     "description": "来源可信度等级"},
                    "usage": {"type": "string", "description": "用途说明"},
                    "verification_status": {"type": "string", "enum": ["verified", "pending"],
                                             "description": "该来源的核验状态"}
                  }
                }
              },
              "limitation_note": {"type": "string", "description": "滞后说明+退出≠清仓声明。必须包含'滞后''退出''不等于清仓''不得作为买卖信号'等表达。"}
            }
          }
        },
        "conclusion_strength_impact": {
          "type": "string",
          "enum": ["upgrade", "downgrade", "neutral", "not_used"]
        }
      }
    },
    "conclusion_strength": {
      "type": "string",
      "enum": ["可定性", "倾向判断", "风险假设", "数据不足"],
      "description": "分析结论强度。有未解决 evidence_gap_requests 时不得为'可定性'。"
    },
    "method_review": {
      "type": "object",
      "description": "砺石方法审查输出（可选字段，按需唤醒时填写，不加入required）",
      "properties": {
        "role_code": {
          "type": "string",
          "const": "LISHI",
          "description": "角色代码（固定LISHI）"
        },
        "result": {
          "type": "string",
          "enum": ["PASS", "WARN", "BLOCK"],
          "description": "方法审查结论"
        },
        "main_challenge": {
          "type": "string",
          "description": "主要方法挑战"
        },
        "calibration_note": {
          "type": "string",
          "description": "给腰子的校准参考"
        },
        "rejected_reason": {
          "type": "string",
          "description": "腰子驳回砺石建议时填写"
        }
      }
    }
  },

  "allOf": [
    {
      "if": {
        "properties": {
          "action_bias": {"enum": ["BUY", "SELL"]}
        }
      },
      "then": {
        "required": ["trigger_condition", "price_range", "position_limit", "time_window"]
      }
    }
  ],

  "硬规则注释": {
    "R1_缺data_fact": "BLOCK — required字段，JSON Schema自动拦截",
    "R2_缺counter_evidence": "BLOCK — minItems:1 + required，JSON Schema自动拦截",
    "R3_缺investment_implication": "BLOCK — required字段",
    "R4_缺invalidation_condition": "BLOCK — required字段",
    "R5_强动作无触发条件": "BLOCK — allOf条件：BUY/SELL时require trigger/price/position/time",
    "R6_低置信强动作": "BLOCK — 需代码层面检查 confidence=LOW + action_bias in (BUY,SELL)",
    "R7_data_fact含结论": "WARN — 需代码层面正则检查（建议/看好/推荐等词）",
    "R8_反证套话": "WARN — 需代码层面检查 counter_evidence仅1条且evidence匹配套话模式"
  }
}
